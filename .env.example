# MediStock — Environment Variables
# Copy this file to .env and fill in values.

# Backend
SECRET_KEY=                    # JWT signing secret (generate a random 64-char hex string)
DATABASE_URL=mysql+pymysql://medistock:password@localhost:3306/medistock
FRONTEND_URL=http://localhost:3000

# Database (used by Docker Compose)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=medistock
MYSQL_USER=medistock
MYSQL_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
